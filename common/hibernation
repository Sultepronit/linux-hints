UUID:
findmnt -n -o UUID -T /swapfile
resume_offset:
filefrag -v /swapfile | awk '{if($1=="0:") print $4}' | tr -d '.'

nano /etc/default/grub.d/99-zswap.cfg
GRUB_CMDLINE_LINUX_DEFAULT="resume=UUID=*** resume_offset=*** zswap.enabled=1 zswap.compressor=zstd
update-grub

nano /etc/initramfs-tools/conf.d/resume
RESUME=UUID=***
update-initramfs -u -k all

systemctl hibernate
echo disk | sudo tee /sys/power/state
lxqt-leave --hibernate

